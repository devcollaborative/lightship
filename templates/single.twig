{% extends "base.twig" %}

{% block content %}
  <article class="post-type-{{ post.post_type }} wp-block-post-content">
    <h1>{{ post.title }}</h1>

    <div class="post-meta">
			by <a href="{{ post.author.path }}"> {{ post.author.name }}</a>
      <span aria-hidden="true">|</span>
      <time datetime="{{ post.date|date('Y-m-d H:i:s') }}">{{ post.date }}</time>
    </div>

    {% include "partials/featured-image.twig" with { image: post.thumbnail } %}

    {% if post.tags %}
      <ul class="post-tags">
        {% for tag in post.tags %}
          <li>
            <a class="post-tag" href="{{ tag.link }}">{{ tag.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if post.categories %}
      <ul class="post-cats">
        {% for category in post.categories %}
          <li>
            <a class="post-cat" href="{{ category.link }}">{{ category.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {{ post.content }}
  </article>
{% endblock %}