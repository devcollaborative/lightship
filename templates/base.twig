<!doctype html>
<html lang="{{ site.language }}">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	{{ function('wp_head') }}
</head>

<body class="{{ body_class }}">
	<a class="skip-link screen-reader-text" href="#mainContent">Skip to content</a>

	{% block header %}
		<header class="site-header">
			<div class="site-branding">
				<a href="{{ site.link }}" rel="home">{{ site.name }}</a>
			</div>

			<nav id="site-navigation" class="main-navigation" aria-label="Main navigation">
				<button id="menu-toggle" aria-expanded="false">
					<svg height="32" width="32" viewBox="0 0 32 32" fill="currentColor" class="menu-toggle--icon">
						<path d="M4,10h24c1.104,0,2-0.896,2-2s-0.896-2-2-2H4C2.896,6,2,6.896,2,8S2.896,10,4,10z M28,14H4c-1.104,0-2,0.896-2,2  s0.896,2,2,2h24c1.104,0,2-0.896,2-2S29.104,14,28,14z M28,22H4c-1.104,0-2,0.896-2,2s0.896,2,2,2h24c1.104,0,2-0.896,2-2  S29.104,22,28,22z"/>
					</svg>
					<div class="menu-toggle--label">Menu</div>
				</button>

				{% include "partials/menu.twig" with { 'menu': primary_menu.get_items } %}
			</nav>
		</header>
	{% endblock %}

	<main id="mainContent" class="site-main">
		{% block content %}
			Sorry, no content.
		{% endblock %}

		{% if sidebar %}
			<aside class="site-sidebar">
				{{ sidebar }}
			</aside>
		{% endif %}
	</main>

	{% block footer %}
		{% include 'partials/footer.twig' %}
	{% endblock %}

	{{ function('wp_footer') }}
</body>
</html>
