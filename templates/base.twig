<!doctype html>
<html {{site.language_attributes}}>
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		{{ function('wp_head') }}
	</head>

	<body class="{{ body_class }}">
		<a class="skip-link screen-reader-text" href="#mainContent">{{ __('Skip to content', 'lightship') }}</a>

		{% block header %}
			<header class="site-header">
				<div class="site-header__top">
					<div
						class="site-header__top--inner">
						{# Mobile nav #}
						<nav class="main-navigation main-navigation--mobile">
							<h2 class="screen-reader-text">{{ __('Main nav', 'lightship') }}</h2>

							{% embed 'disclosure/disclosure-element.twig' with { class: 'navigation-disclosure' } %}
								{% block button %}
									{{ icon('menu') }}
									{{ icon('close') }}
									{{ __('Menu', 'lightship') }}
								{% endblock %}
								{% block content %}
									{% include "partials/menu-disclosure.twig" with { 'menu': primary_menu.get_items, 'direction': 'vertical' } %}
								{% endblock %}
							{% endembed %}
						</nav>

						{% include "partials/menu.twig" with { 'menu': top_header_menu.get_items, 'class': 'top-header-menu' } %}

						{#  Search form - shared on mobile & desktop #}
						{% embed 'disclosure/disclosure-element.twig' with { class: 'search-disclosure' } %}
							{% block button %}
								<span>{{ __('Search', 'lightship') }}</span>
								{{ icon('search') }}
							{% endblock %}
							{% block content %}
								<form role="search" method="get" class="search-form" action="{{ site.link }}">
									<label class="screen-reader-text" for="s">{{ __('Search', 'lightship') }}</label>
									<input id="s" type="search" class="search-field" placeholder="{{ __('Search', 'lightship') }}" value="{{ fn('get_search_query') }}" name="s">
									<button type="submit" class="search-submit">
										<span class="screen-reader-text">{{ __('Search', 'lightship') }}</span>
										{{ icon('search') }}
									</button>
								</form>
							{% endblock %}
						{% endembed %}

						<a class="button button-secondary" href="/donate/">{{ __('Donate', 'lightship') }}</a>
					</div>
				</div>

				<div class="site-header__main">
					<a class="site-branding" href="{{ site.link }}" rel="home">
						<img src="{{ theme.link }}/assets/img/logo.svg" alt="{{ site.name }}">
					</a>

					{# Desktop nav #}
					<nav class="main-navigation main-navigation--desktop">
						{% include "partials/menu-disclosure.twig" with { 'menu': primary_menu.get_items } %}
					</nav>
				</div>
			</header>
		{% endblock %}

		<main id="mainContent" class="site-main"> {% block content %}{% endblock %}
			</main>

			{% block footer %}
				{% include 'partials/footer.twig' %}
			{% endblock %}

			{{ fn('file_get_contents', fn('get_stylesheet_directory') ~ '/sprite/sprite.svg') }}

			{{ function('wp_footer') }}
		</body>
	</html>
