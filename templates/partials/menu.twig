{% if menu %}
	<ul class="{{ class }} menu">
    {% for item in menu %}
      <li class="{{ item.classes | join(' ') }}">
        <a target="{{ item.target }}" href="{{ item.link }}">{{ item.title }}</a>

        {% include "partials/menu.twig" with { 'menu': item.children } %}
      </li>
    {% endfor %}
	</ul>
{% endif %}
