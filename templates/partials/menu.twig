{% if menu %}
	<ul>
    {% for item in menu %}
      <li class="{{ item.classes | join(' ') }}">
        <a target="{{ item.target }}" href="{{ item.link }}">{{ item.title }}</a>

        {% if item.children %}
          <button class="submenu-toggle" type="button" aria-label="{{ item.title }}"></button>

          <ul>
            {% for item in item.children %}
              <li class="{{ item.classes | join(' ') }}">
                <a target="{{ item.target }}" href="{{ item.link }}">{{ item.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
	</ul>
{% endif %}
