{% if menu %}
  <nav class="social-media-nav" aria-label="Social media">
    <ul class="menu social-media--menu">
      {% for item in menu %}
        <li class="{{ item.classes | join(' ') }} social-media--item">
          <a target="{{ item.target }}"  href="{{ item.link }}" rel="noopener">
            <span class="screen-reader-text">{{ item.title }}</span>
            {% if 'facebook' in item.link %}
              {{ icon('facebook') }}
            {% elseif 'x.com' in item.link or 'twitter' in item.link %}
              {{ icon('x') }}
            {% elseif 'instagram' in item.link %}
              {{ icon('instagram') }}
            {% elseif 'linkedin' in item.link %}
              {{ icon('linkedin') }}
            {% elseif 'tiktok' in item.link %}
              {{ icon('tiktok') }}
            {% elseif 'bluesky' in item.link %}
              {{ icon('bluesky') }}
            {% elseif 'threads' in item.link %}
              {{ icon('threads') }}
            {% elseif 'youtube' in item.link %}
              {{ icon('youtube') }}
            {% elseif 'mastodon' in item.link %}
              {{ icon('mastodon') }}
            {% elseif 'rss' in item.link %}
              {{ icon('rss') }}
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
