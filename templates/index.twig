{% extends "base.twig" %}

{% block content %}
	<article class="wp-block-post-content">
		{% for post in posts %}
			{% include ['partials/teaser-' ~ post.post_type ~ '.twig', 'partials/teaser.twig'] %}
		{% else %}
			<p>No posts found.</p>
		{% endfor %}

		{% include 'partials/pagination.twig' %}
  </article>
{% endblock %}
