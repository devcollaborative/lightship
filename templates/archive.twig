{% extends "base.twig" %}

{% block content %}
	<article>
		<h1>{{ archive_title }}</h2>

		{% if archive_description %}
			<p>{{ archive_description }}</p>
		{% endif %}

		{% for post in posts %}
			{% include ['partials/teaser-' ~ post.post_type ~ '.twig', 'partials/teaser.twig'] %}
		{% else %}
			<p>No posts found.</p>
		{% endfor %}

		{% include 'partials/pagination.twig' %}
	</article>
{% endblock %}
