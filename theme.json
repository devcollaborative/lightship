{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
    "layout": {
			"contentSize": "var(--page-width)",
			"wideSize": "var(--page-width-wide)"
		},
    "color": {
      "palette": [],
      "gradients": [],
      "duotone": [],
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false
    },
    "typography": {
      "dropCap": false,
      "letterSpacing": false,
      "customFontSize": false,
      "fontStyle": false,
      "fontWeight": false,
      "fontFamilies": [
        {
          "name": "Libre Franklin",
          "slug": "font-primary",
          "fontFamily": "\"Libre Franklin\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Libre Franklin",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/libre-franklin-v20-latin-regular.woff2"]
            },
            {
              "fontFamily": "Libre Franklin",
              "fontWeight": "400",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/libre-franklin-v20-latin-italic.woff2"]
            },
            {
              "fontFamily": "Libre Franklin",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/libre-franklin-v20-latin-700.woff2"]
            },
            {
              "fontFamily": "Libre Franklin",
              "fontWeight": "700",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/libre-franklin-v20-latin-700italic.woff2"]
            }
          ]
        },
        {
          "name": "Lora",
          "slug": "font-secondary",
          "fontFamily": "\"Lora\", serif",
          "fontFace": [
            {
              "fontFamily": "Lora",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/lora-v37-latin-regular.woff2"]
            },
            {
              "fontFamily": "Lora",
              "fontWeight": "400",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/lora-v37-latin-italic.woff2"]
            },
            {
              "fontFamily": "Lora",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/lora-v37-latin-600.woff2"]
            },
            {
              "fontFamily": "Lora",
              "fontWeight": "600",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/lora-v37-latin-600italic.woff2"]
            }
          ]
        }
      ],
      "defaultFontSizes": false
    },
    "spacing": {
      "defaultSpacingSizes": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "blocks": {
			"core/button": {
        "border": {
          "radius": false
        }
      },
      "core/group": {
        "color": {
          "heading": false,
          "text": false,
          "palette": [
            {
              "slug": "grey",
              "color": "var(--grey)",
              "name": "Grey"
            },
            {
              "slug": "blue",
              "color": "var(--blue)",
              "name": "Blue"
            },
            {
              "slug": "dark-blue",
              "color": "var(--dark-blue)",
              "name": "Dark Blue"
            }
          ]
        }
      },
      "core/media-text": {
        "color": {
          "heading": false,
          "text": false,
          "palette": [
            {
              "slug": "grey",
              "color": "var(--grey)",
              "name": "Grey"
            },
            {
              "slug": "blue",
              "color": "var(--blue)",
              "name": "Blue"
            },
            {
              "slug": "dark-blue",
              "color": "var(--dark-blue)",
              "name": "Dark Blue"
            }
          ]
        }
      }
		}
  }
}
