{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
    "layout": {
			"contentSize": "var(--page-width)",
			"wideSize": "var(--page-width-wide)"
		},
    "color": {
      "palette": [],
      "gradients": [],
      "duotone": [],
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false
    },
    "typography": {
      "dropCap": false,
      "letterSpacing": false,
      "customFontSize": false,
      "fontStyle": false,
      "fontWeight": false,
      "fontFamilies": [],
      "defaultFontSizes": false
    },
    "spacing": {
      "defaultSpacingSizes": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "blocks": {
			"core/button": {
        "border": {
          "radius": false
        }
      },
      "core/group": {
        "color": {
          "heading": false,
          "text": false,
          "palette": [
            {
              "slug": "grey",
              "color": "var(--grey)",
              "name": "Grey"
            },
            {
              "slug": "blue",
              "color": "var(--blue)",
              "name": "Blue"
            },
            {
              "slug": "dark-blue",
              "color": "var(--dark-blue)",
              "name": "Dark Blue"
            }
          ]
        }
      },
      "core/media-text": {
        "color": {
          "heading": false,
          "text": false,
          "palette": [
            {
              "slug": "grey",
              "color": "var(--grey)",
              "name": "Grey"
            },
            {
              "slug": "blue",
              "color": "var(--blue)",
              "name": "Blue"
            },
            {
              "slug": "dark-blue",
              "color": "var(--dark-blue)",
              "name": "Dark Blue"
            }
          ]
        }
      }
		}
  }
}
